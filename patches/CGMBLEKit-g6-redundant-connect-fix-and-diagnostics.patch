+// MARK: - [G6DIAG] Session diagnostics
+
+extension CBPeripheralState {
+    var diagnosticName: String {
+        switch self {
+        case .disconnected:
+            return "disconnected"
+        case .connecting:
+            return "connecting"
+        case .connected:
