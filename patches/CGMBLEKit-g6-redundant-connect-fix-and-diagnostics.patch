+
+
+/// Logging-only diagnostics for the G5/G6 connection lifecycle. Nothing here changes Bluetooth
+/// behavior.
+///
+/// Every line is tagged `[G6DIAG]` and logged at default level, so Trio's CGM log export (which
+/// reads persisted `com.loopkit.CGMBLEKit` entries) captures it. Times are seconds since the first
+/// `didConnect` of the session on the monotonic uptime clock. Each session ends with one
+/// `summary` line, which is what offline analysis keys on.
+final class G6SessionDiagnostics {
+    static let shared = G6SessionDiagnostics()
+
+    /// Posted after every session summary. userInfo: "session" (String), "glucoseSeen" (Bool).
+    /// Trio observes it by name, so the string must match Trio's PluginSource.
+    static let sessionDidEndNotification = Notification.Name("com.loopkit.CGMBLEKit.G6SessionDidEnd")
+
+    private let log = OSLog(category: "G6Diagnostics")
+
+    private let lock = NSLock()
+
+    // All state below is guarded by `lock`
+    private var sessionNumber = 0
+    private var sessionStart: TimeInterval?
+    private var connectCount = 0
+    private var skippedReconnectAt: TimeInterval?
+    private var redundantConnectAt: TimeInterval?
+    private var skippedReconnectMsBefore: Int?
+    private var redundantConnectMsBefore: Int?
+    private var milestones: [(name: String, elapsed: TimeInterval)] = []
+    private var controlOpcodes: [String] = []
+    private var dropCount = 0
+    private var forwardCount = 0
+
+    private init() {}
+
+    private var uptime: TimeInterval {
+        return ProcessInfo.processInfo.systemUptime
+    }
+
+    /// Records what `BluetoothManager` did when asked to (re)connect.
+    func reconnectDecision(caller: String, state: String, action: String) {
+        let now = uptime
+
+        lock.lock()
+        if state == "connecting" {
+            if action == "skipped" {
+                skippedReconnectAt = now
+            } else if action.hasPrefix("connect") {
+                redundantConnectAt = now
+            }
+        }
+        let session = sessionStart == nil ? "idle" : "S\(sessionNumber)"
+        lock.unlock()
+
+        emit("reconnect caller=\(caller) state=\(state) action=\(action) session=\(session) uptime=\(G6SessionDiagnostics.format(now))")
+    }
+
+    func didConnect() {
+        let now = uptime
+        let line: String
+
+        lock.lock()
+        if let start = sessionStart, now - start < 10 {
+            connectCount += 1
+            line = "S\(sessionNumber) didConnect #\(connectCount) DUPLICATE +\(G6SessionDiagnostics.format(now - start))"
+        } else {
+            sessionNumber += 1
+            sessionStart = now
+            connectCount = 1
+            milestones = []
+            controlOpcodes = []
+            dropCount = 0
+            forwardCount = 0
+            skippedReconnectMsBefore = G6SessionDiagnostics.millisecondsBefore(now, skippedReconnectAt)
+            redundantConnectMsBefore = G6SessionDiagnostics.millisecondsBefore(now, redundantConnectAt)
+            skippedReconnectAt = nil
+            redundantConnectAt = nil
+            line = "S\(sessionNumber) didConnect #1 skippedReconnectMsBefore=\(G6SessionDiagnostics.describe(skippedReconnectMsBefore)) redundantConnectMsBefore=\(G6SessionDiagnostics.describe(redundantConnectMsBefore)) uptime=\(G6SessionDiagnostics.format(now))"
+        }
+        lock.unlock()
+
+        emit(line)
+    }
+
+    /// Records a named step of the current session.
+    func milestone(_ name: String, _ detail: String = "") {
+        let now = uptime
+        let suffix = detail.isEmpty ? "" : " " + detail
+        let line: String
+
+        lock.lock()
+        if let start = sessionStart {
+            let elapsed = now - start
+            milestones.append((name: name, elapsed: elapsed))
+            line = "S\(sessionNumber) +\(G6SessionDiagnostics.format(elapsed)) \(name)\(suffix)"
+        } else {
+            line = "idle \(name)\(suffix)"
+        }
+        lock.unlock()
+
+        emit(line)
+    }
+
+    /// Records an indication received on the control characteristic.
+    func controlResponse(_ response: Data) {
+        guard let opcode = response.first else {
+            return
+        }
+        let code = String(format: "%02x", opcode)
+
+        lock.lock()
+        if sessionStart != nil {
+            controlOpcodes.append(code)
+        }
+        lock.unlock()
+
+        milestone("controlRx", "op=\(code) len=\(response.count)")
+    }
+
+    /// Records an unsolicited value that `PeripheralManager` discarded because a command was pending.
+    func droppedValue(characteristic: String, value: Data?, pending: String) {
+        var opcode = "none"
+        if let byte = value?.first {
+            opcode = String(format: "%02x", byte)
+        }
+
+        lock.lock()
+        dropCount += 1
+        lock.unlock()
+
+        milestone("DROPPED", "char=\(characteristic) op=\(opcode) len=\(value?.count ?? 0) pending=\(pending)")
+    }
+
+    /// Records an unsolicited value that F3 passed to the delegate while a subscription setup was pending.
+    func forwardedValue(characteristic: String, value: Data?, pending: String) {
+        var opcode = "none"
+        if let byte = value?.first {
+            opcode = String(format: "%02x", byte)
+        }
+
+        lock.lock()
+        forwardCount += 1
+        lock.unlock()
+
+        milestone("FORWARDED", "char=\(characteristic) op=\(opcode) len=\(value?.count ?? 0) pending=\(pending)")
+    }
+
+    func didDisconnect(errorCode: Int?) {
+        let now = uptime
+        let line: String
+        var endedSession: (name: String, glucoseSeen: Bool)?
+
+        lock.lock()
+        if let start = sessionStart {
+            let ops = controlOpcodes.isEmpty ? "none" : controlOpcodes.joined(separator: ",")
+            let parts: [String] = [
+                "S\(sessionNumber) summary",
+                "conns=\(connectCount)",
+                "skippedReconnectMsBefore=\(G6SessionDiagnostics.describe(skippedReconnectMsBefore))",
+                "redundantConnectMsBefore=\(G6SessionDiagnostics.describe(redundantConnectMsBefore))",
+                "authSub=\(firstTime("authSubscribed"))",
+                "authOK=\(firstTime("authRxAccepted"))",
+                "ctrlSub=\(firstTime("controlSubscribed"))",
+                "glucose=\(firstTime("glucose"))",
+                "drops=\(dropCount)",
+                "fwd=\(forwardCount)",
+                "ops=\(ops)",
+                "end=+\(G6SessionDiagnostics.format(now - start))",
+                "err=\(G6SessionDiagnostics.describe(errorCode))",
+            ]
+            line = parts.joined(separator: " ")
+            endedSession = (name: "S\(sessionNumber)", glucoseSeen: milestones.contains(where: { $0.name == "glucose" }))
+            sessionStart = nil
+        } else {
+            line = "idle didDisconnect err=\(G6SessionDiagnostics.describe(errorCode))"
+        }
+        lock.unlock()
+
+        emit(line)
+
+        // Lets Trio react to a session that ended without a reading (Share retry after a miss)
+        if let endedSession = endedSession {
+            NotificationCenter.default.post(
+                name: G6SessionDiagnostics.sessionDidEndNotification,
+                object: nil,
+                userInfo: ["session": endedSession.name, "glucoseSeen": endedSession.glucoseSeen]
+            )
+        }
+    }
+
+    /// Short name for a G5/G6 characteristic, for log lines.
+    static func name(for uuid: CBUUID) -> String {
+        if let known = CGMServiceCharacteristicUUID(rawValue: uuid.uuidString.uppercased()) {
+            return String(describing: known)
+        }
+        return uuid.uuidString
+    }
+
+    // MARK: Private
+
+    /// Must be called with `lock` held.
+    private func firstTime(_ name: String) -> String {
+        guard let match = milestones.first(where: { $0.name == name }) else {
+            return "none"
+        }
+        return "+" + G6SessionDiagnostics.format(match.elapsed)
+    }
+
+    private func emit(_ message: String) {
+        log.default("[G6DIAG] %{public}@", message)
+    }
+
+    private static func format(_ seconds: TimeInterval) -> String {
+        return String(format: "%.3f", seconds)
+    }
+
+    private static func describe(_ value: Int?) -> String {
+        guard let value = value else {
+            return "none"
+        }
+        return "\(value)"
+    }
+
+    /// Milliseconds from `event` to `now`, if `event` happened in the 5 seconds before `now`.
+    private static func millisecondsBefore(_ now: TimeInterval, _ event: TimeInterval?) -> Int? {
+        guard let event = event, now >= event, now - event < 5 else {
+            return nil
+        }
+        return Int(((now - event) * 1000).rounded())
+    }
+}
+
+
+// MARK: - Passive-mode fixes
+
+/// Runtime switches for the G5/G6 Bluetooth reliability fixes. Both default on, and true
+/// always means the fix is active. Trio sets them from CGM settings through the public properties
+/// on `Transmitter`.
+final class PassiveModeFixes {
+    static let shared = PassiveModeFixes()
+
+    private let lockedSkipRedundantReconnect: Locked<Bool> = Locked(true)
+    private let lockedKeepMessagesDuringSubscriptionSetup: Locked<Bool> = Locked(true)
+
+    private init() {}
+
+    /// Reconnect fix: the periodic `resumeScanning()` does not re-issue `connect()` while a
+    /// connection is already pending, which prevents duplicate `didConnect` callbacks.
+    var skipRedundantReconnect: Bool {
+        get {
+            return lockedSkipRedundantReconnect.value
+        }
+        set {
+            lockedSkipRedundantReconnect.value = newValue
+        }
+    }
+
+    /// F3: when the only pending command is a subscription (notification-state) setup, pass
+    /// incoming values to the delegate instead of discarding them.
+    var keepMessagesDuringSubscriptionSetup: Bool {
+        get {
+            return lockedKeepMessagesDuringSubscriptionSetup.value
+        }
+        set {
+            lockedKeepMessagesDuringSubscriptionSetup.value = newValue
+        }
+    }
+}
