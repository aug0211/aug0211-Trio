+extension Transmitter {
+    /// Subscribes to the control characteristic once per session. Only a successful subscription
+    /// counts, so a failed early attempt does not block the normal one.
+    ///
+    /// Must run on the peripheral manager's queue.
+    private func subscribeToControlIfNeeded(_ peripheral: PeripheralManager) {
+        guard !sessionControlSubscribed else {
+            G6SessionDiagnostics.shared.milestone("controlAlreadySubscribed")
+            return
+        }
+
+        do {
+            try peripheral.listenToCharacteristic(.control)
+            sessionControlSubscribed = true
+            G6SessionDiagnostics.shared.milestone("controlSubscribed")
+        } catch let error {
+            G6SessionDiagnostics.shared.milestone("controlSubscribeFailed", String(describing: error))
+            log.error("Error trying to enable notifications on control characteristic: %{public}@", String(describing: error))
+            delegateQueue.async {
+                self.delegate?.transmitter(self, didError: error)
+            }
+        }
+    }
+}
