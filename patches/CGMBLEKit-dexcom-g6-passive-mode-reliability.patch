+//
+//  TransmitterSessionLog.swift
+//  CGMBLEKit
+//
+
+import CoreBluetooth
+import Foundation
+import os.log
+
+
+/// Logs each Bluetooth connection ("session") to a G5/G6 transmitter, step by step, and ends it
+/// with one summary line.
+///
+/// Logging only: nothing here changes Bluetooth behavior. The one exception is that it posts
+/// `Transmitter.connectionDidEndNotification` when a connection ends, because this is the one
+/// place that knows whether the connection delivered a reading.
+///
+/// Lines are tagged `[G6DIAG]` and logged at default level, so an app's log export (which reads
+/// persisted `com.loopkit.CGMBLEKit` entries) includes them. Times are seconds since the session's
+/// first `didConnect`, on the uptime clock. Example summary:
+///
+///     S12 summary conns=1 skippedReconnectMsBefore=4 redundantConnectMsBefore=none authSub=+0.240
+///     authOK=+0.361 ctrlSub=+0.420 glucose=+0.660 drops=0 fwd=1 ops=25,4f,33 end=+1.010 err=7
+final class TransmitterSessionLog {
+    static let shared = TransmitterSessionLog()
+
+    private let log = OSLog(category: "G6Diagnostics")
+
+    private let lock = NSLock()
+
+    // All state below is guarded by `lock`
+    private var sessionNumber = 0
+    private var sessionStart: TimeInterval?
+    private var connectCount = 0
+    private var skippedReconnectAt: TimeInterval?
+    private var redundantConnectAt: TimeInterval?
+    private var skippedReconnectMsBefore: Int?
+    private var redundantConnectMsBefore: Int?
+    private var milestones: [(name: String, elapsed: TimeInterval)] = []
+    private var controlOpcodes: [String] = []
+    private var discardedCount = 0
+    private var keptCount = 0
+
+    private init() {}
+
+    private var uptime: TimeInterval {
+        return ProcessInfo.processInfo.systemUptime
+    }
+
+    // MARK: - Connection lifecycle
+
+    /// Records what `BluetoothManager` did when asked to (re)connect, and who asked.
+    func reconnectDecision(caller: String, state: String, action: String) {
+        let now = uptime
+
+        lock.lock()
+        if state == "connecting" {
+            if action == "skipped" {
+                skippedReconnectAt = now
+            } else if action.hasPrefix("connect") {
+                redundantConnectAt = now
+            }
+        }
+        let session = sessionStart == nil ? "idle" : "S\(sessionNumber)"
+        lock.unlock()
+
+        emit("reconnect caller=\(caller) state=\(state) action=\(action) session=\(session) uptime=\(TransmitterSessionLog.format(now))")
+    }
+
+    /// Starts a session, or flags a duplicate callback if one started less than 10 seconds ago.
+    func didConnect() {
+        let now = uptime
+        let line: String
+
+        lock.lock()
+        if let start = sessionStart, now - start < 10 {
+            connectCount += 1
+            line = "S\(sessionNumber) didConnect #\(connectCount) DUPLICATE +\(TransmitterSessionLog.format(now - start))"
+        } else {
+            sessionNumber += 1
+            sessionStart = now
+            connectCount = 1
+            milestones = []
+            controlOpcodes = []
+            discardedCount = 0
+            keptCount = 0
+            skippedReconnectMsBefore = TransmitterSessionLog.millisecondsBefore(now, skippedReconnectAt)
+            redundantConnectMsBefore = TransmitterSessionLog.millisecondsBefore(now, redundantConnectAt)
+            skippedReconnectAt = nil
+            redundantConnectAt = nil
+            line = "S\(sessionNumber) didConnect #1 skippedReconnectMsBefore=\(TransmitterSessionLog.describe(skippedReconnectMsBefore)) redundantConnectMsBefore=\(TransmitterSessionLog.describe(redundantConnectMsBefore)) uptime=\(TransmitterSessionLog.format(now))"
+        }
+        lock.unlock()
+
+        emit(line)
+    }
+
+    /// Ends the session: logs the summary line and posts `Transmitter.connectionDidEndNotification`.
+    func didDisconnect(errorCode: Int?) {
+        let now = uptime
+        let line: String
+        var endedSession: (name: String, receivedGlucose: Bool)?
+
+        lock.lock()
+        if let start = sessionStart {
+            let ops = controlOpcodes.isEmpty ? "none" : controlOpcodes.joined(separator: ",")
+            let parts: [String] = [
+                "S\(sessionNumber) summary",
+                "conns=\(connectCount)",
+                "skippedReconnectMsBefore=\(TransmitterSessionLog.describe(skippedReconnectMsBefore))",
+                "redundantConnectMsBefore=\(TransmitterSessionLog.describe(redundantConnectMsBefore))",
+                "authSub=\(firstTime("authSubscribed"))",
+                "authOK=\(firstTime("authRxAccepted"))",
+                "ctrlSub=\(firstTime("controlSubscribed"))",
+                "glucose=\(firstTime("glucose"))",
+                "drops=\(discardedCount)",
+                "fwd=\(keptCount)",
+                "ops=\(ops)",
+                "end=+\(TransmitterSessionLog.format(now - start))",
+                "err=\(TransmitterSessionLog.describe(errorCode))",
+            ]
+            line = parts.joined(separator: " ")
+            endedSession = (name: "S\(sessionNumber)", receivedGlucose: milestones.contains(where: { $0.name == "glucose" }))
+            sessionStart = nil
+        } else {
+            line = "idle didDisconnect err=\(TransmitterSessionLog.describe(errorCode))"
+        }
+        lock.unlock()
+
+        emit(line)
+
+        if let endedSession = endedSession {
+            NotificationCenter.default.post(
+                name: Transmitter.connectionDidEndNotification,
+                object: nil,
+                userInfo: [
+                    Transmitter.connectionDidEndSessionKey: endedSession.name,
+                    Transmitter.connectionDidEndReceivedGlucoseKey: endedSession.receivedGlucose,
+                ]
+            )
+        }
+    }
+
+    // MARK: - Steps within a session
+
+    /// Records a named step of the current session, such as "authSubscribed" or "glucose".
+    func milestone(_ name: String, _ detail: String = "") {
+        let now = uptime
+        let suffix = detail.isEmpty ? "" : " " + detail
+        let line: String
+
+        lock.lock()
+        if let start = sessionStart {
+            let elapsed = now - start
+            milestones.append((name: name, elapsed: elapsed))
+            line = "S\(sessionNumber) +\(TransmitterSessionLog.format(elapsed)) \(name)\(suffix)"
+        } else {
+            line = "idle \(name)\(suffix)"
+        }
+        lock.unlock()
+
+        emit(line)
+    }
+
+    /// Records a message received on the control characteristic.
+    func controlResponse(_ response: Data) {
+        guard let opcode = response.first else {
+            return
+        }
+        let code = String(format: "%02x", opcode)
+
+        lock.lock()
+        if sessionStart != nil {
+            controlOpcodes.append(code)
+        }
+        lock.unlock()
+
+        milestone("controlRx", "op=\(code) len=\(response.count)")
+    }
+
+    /// Records a message `PeripheralManager` discarded because a command was pending.
+    func messageDiscarded(characteristic: CBUUID, value: Data?, pending: String) {
+        lock.lock()
+        discardedCount += 1
+        lock.unlock()
+
+        milestone("DROPPED", TransmitterSessionLog.describeMessage(characteristic: characteristic, value: value, pending: pending))
+    }
+
+    /// Records a message `PeripheralManager` passed on while a subscription was being set up.
+    func messageKept(characteristic: CBUUID, value: Data?, pending: String) {
+        lock.lock()
+        keptCount += 1
+        lock.unlock()
+
+        milestone("FORWARDED", TransmitterSessionLog.describeMessage(characteristic: characteristic, value: value, pending: pending))
+    }
+
+    // MARK: - Formatting
+
+    /// Short name for a G5/G6 characteristic, such as "authentication" or "control".
+    static func name(for uuid: CBUUID) -> String {
+        if let known = CGMServiceCharacteristicUUID(rawValue: uuid.uuidString.uppercased()) {
+            return String(describing: known)
+        }
+        return uuid.uuidString
+    }
+
+    /// Must be called with `lock` held.
+    private func firstTime(_ name: String) -> String {
+        guard let match = milestones.first(where: { $0.name == name }) else {
+            return "none"
+        }
+        return "+" + TransmitterSessionLog.format(match.elapsed)
+    }
+
+    private func emit(_ message: String) {
+        log.default("[G6DIAG] %{public}@", message)
+    }
+
+    /// Opcode and length only: some messages carry authentication material.
+    private static func describeMessage(characteristic: CBUUID, value: Data?, pending: String) -> String {
+        let opcode = value?.first.map { String(format: "%02x", $0) } ?? "none"
+        return "char=\(name(for: characteristic)) op=\(opcode) len=\(value?.count ?? 0) pending=\(pending)"
+    }
+
+    private static func format(_ seconds: TimeInterval) -> String {
+        return String(format: "%.3f", seconds)
+    }
+
+    private static func describe(_ value: Int?) -> String {
+        guard let value = value else {
+            return "none"
+        }
+        return "\(value)"
+    }
+
+    /// Milliseconds from `event` to `now`, if `event` happened in the 5 seconds before `now`.
+    private static func millisecondsBefore(_ now: TimeInterval, _ event: TimeInterval?) -> Int? {
+        guard let event = event, now >= event, now - event < 5 else {
+            return nil
+        }
+        return Int(((now - event) * 1000).rounded())
+    }
+}
+
+
+extension CBPeripheralState {
+    /// Name used in session log lines.
+    var logName: String {
+        switch self {
+        case .disconnected:
+            return "disconnected"
+        case .connecting:
+            return "connecting"
+        case .connected:
+            return "connected"
+        case .disconnecting:
+            return "disconnecting"
+        @unknown default:
+            return "unknown(\(rawValue))"
+        }
+    }
+}
+
+
+extension PeripheralManager.CommandCondition {
+    /// Short description used in session log lines, such as "notify(authentication,true)".
+    var logDescription: String {
+        switch self {
+        case .notificationStateUpdate(let characteristicUUID, let enabled):
+            return "notify(\(TransmitterSessionLog.name(for: characteristicUUID)),\(enabled))"
+        case .valueUpdate(let characteristic, _):
+            return "value(\(TransmitterSessionLog.name(for: characteristic.uuid)))"
+        case .write(let characteristic):
+            return "write(\(TransmitterSessionLog.name(for: characteristic.uuid)))"
+        case .discoverServices:
+            return "discoverServices"
+        case .discoverCharacteristicsForService:
+            return "discoverCharacteristics"
+        }
+    }
+}
