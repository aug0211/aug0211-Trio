+    /// delivered a glucose reading. `userInfo[Transmitter.connectionDidEndSessionKey]` (String) is
+    /// the connection's label in the logs, such as "S12".
+    public static let connectionDidEndNotification = Notification.Name("com.loopkit.CGMBLEKit.TransmitterConnectionDidEnd")
+    public static let connectionDidEndReceivedGlucoseKey = "receivedGlucose"
+    public static let connectionDidEndSessionKey = "session"
+}
