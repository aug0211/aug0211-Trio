+extension Transmitter {
+    /// Subscribes to the control characteristic, once per connection. Now that messages arriving
+    /// during setup are kept, the Dexcom app's "authenticated" message can be seen at more than one
+    /// point in a connection; this keeps that from subscribing twice. Only a successful
+    /// subscription counts, so a failed attempt doesn't block a later one.
+    ///
+    /// Must run on the peripheral manager's queue.
+    private func subscribeToControlIfNeeded(_ peripheral: PeripheralManager) {
+        guard !sessionControlSubscribed else {
+            TransmitterSessionLog.shared.milestone("controlAlreadySubscribed")
+            return
+        }
+
+        do {
+            try peripheral.listenToCharacteristic(.control)
+            sessionControlSubscribed = true
+            TransmitterSessionLog.shared.milestone("controlSubscribed")
+        } catch let error {
+            TransmitterSessionLog.shared.milestone("controlSubscribeFailed", String(describing: error))
+            log.error("Error trying to enable notifications on control characteristic: %{public}@", String(describing: error))
