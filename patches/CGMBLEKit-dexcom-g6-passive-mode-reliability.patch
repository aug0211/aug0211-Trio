diff --git a/CGMBLEKit/CGMBLEKit/PassiveModeOptions.swift b/CGMBLEKit/CGMBLEKit/PassiveModeOptions.swift
new file mode 100644
index 0000000..f5521c9
--- /dev/null
+++ b/CGMBLEKit/CGMBLEKit/PassiveModeOptions.swift
@@ -0,0 +1,44 @@
+//
+//  PassiveModeOptions.swift
+//  CGMBLEKit
+//
+
+import Foundation
+
+
+/// Switches for two passive-mode reliability fixes. Both default on, and `true` always means the
+/// fix is active.
+///
+/// Apps set them through `Transmitter.preventDuplicateConnections` and
+/// `Transmitter.keepMessagesDuringSetup`. They exist so either fix can be turned off for a
+/// deliberate comparison without rebuilding.
+final class PassiveModeOptions {
+    static let shared = PassiveModeOptions()
+
+    private let lockedPreventDuplicateConnections: Locked<Bool> = Locked(true)
+    private let lockedKeepMessagesDuringSetup: Locked<Bool> = Locked(true)
+
+    private init() {}
+
+    /// Don't ask CoreBluetooth to connect again while a connection is already pending.
+    /// See `BluetoothManager.resumeScanning(preventDuplicateConnection:)`.
+    var preventDuplicateConnections: Bool {
+        get {
+            return lockedPreventDuplicateConnections.value
+        }
+        set {
+            lockedPreventDuplicateConnections.value = newValue
+        }
+    }
+
+    /// Pass on messages that arrive while a subscription is being set up, instead of discarding
+    /// them. See `PeripheralManager.peripheral(_:didUpdateValueFor:error:)`.
+    var keepMessagesDuringSetup: Bool {
+        get {
+            return lockedKeepMessagesDuringSetup.value
+        }
+        set {
+            lockedKeepMessagesDuringSetup.value = newValue
+        }
+    }
+}
